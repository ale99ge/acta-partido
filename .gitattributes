# Normaliza los finales de línea para que Windows y Linux no se peleen.
* text=auto eol=lf

# Los scripts de Windows necesitan CRLF o el intérprete falla
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf working-tree-encoding=UTF-8

# Binarios: que Git no los toque
*.png  binary
*.apk  binary
*.aab  binary
*.keystore binary
